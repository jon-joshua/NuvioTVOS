<plist version="1.0">
<dict>
	<!-- Debug/device builds sign with whatever team the developer has, including
	     a free personal team, so this file requests no capabilities. The app does
	     not use push or associated domains, and TopShelfFeed already tolerates a
	     missing app-group container. Release keeps NuvioTV.entitlements. -->
</dict>
</plist>
